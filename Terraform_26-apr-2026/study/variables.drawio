        <mxCell id="snVvS5CivcIrdgKPao7X-29" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Variable Type&lt;/th&gt;&lt;th&gt;Description&lt;/th&gt;&lt;th&gt;Real Use Case Example&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;string&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores a single text value&lt;/td&gt;&lt;td&gt;Resource names, regions, VM sizes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;number&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores numeric values&lt;/td&gt;&lt;td&gt;VM count, disk size, port numbers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;bool&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores true or false&lt;/td&gt;&lt;td&gt;Enable backup, public IP, monitoring&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;list(type)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores multiple ordered values&lt;/td&gt;&lt;td&gt;Subnets, IP ranges, security rules&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;map(type)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores key-value pairs&lt;/td&gt;&lt;td&gt;Tags, labels, environment configs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;object({...})&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores grouped structured values&lt;/td&gt;&lt;td&gt;Full VM, network, or app configurations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;tuple([...])&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores fixed ordered mixed values&lt;/td&gt;&lt;td&gt;Predefined system settings&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;set(type)&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores unique unordered values&lt;/td&gt;&lt;td&gt;Unique ports, regions, firewall rules&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="290" width="680" x="105" y="1120" as="geometry" />
